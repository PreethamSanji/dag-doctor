# Anthropic API key used for triage + evals
LLM_API_KEY=sk-ant-...
# Overrides config/default.yaml agent.model when set
LLM_MODEL=claude-opus-5

# pgvector-backed Postgres (docker compose service: db)
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# Local Airflow (docker compose service: airflow)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
